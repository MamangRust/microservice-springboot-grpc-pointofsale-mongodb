APP_ENV=docker

# Satu instance MongoDB; tiap bounded context memakai database terpisah
# (lihat docker-compose.yml: service `mongo`).
# Tiap microservice membaca <MODULE>_DB_HOST/_PORT/_NAME.
DB_MIGRATE_HOST=mongo
DB_MIGRATE_PORT=27017
DB_MIGRATE_NAME=pos_identity

# Konteks bounded (untuk referensi / tooling):
DB_IDENTITY_HOST=mongo
DB_IDENTITY_PORT=27017
DB_IDENTITY_NAME=pos_identity
DB_MERCHANT_HOST=mongo
DB_MERCHANT_PORT=27017
DB_MERCHANT_NAME=pos_merchant
DB_CATALOG_HOST=mongo
DB_CATALOG_PORT=27017
DB_CATALOG_NAME=pos_catalog
DB_SALES_HOST=mongo
DB_SALES_PORT=27017
DB_SALES_NAME=pos_sales
DB_EMAIL_HOST=mongo
DB_EMAIL_PORT=27017
DB_EMAIL_NAME=pos_email

# ---- Spring Boot per-bounded-context MongoDB (dipakai tiap service) ----
ROLE_DB_HOST=mongo
ROLE_DB_PORT=27017
ROLE_DB_NAME=pos_identity
USER_DB_HOST=mongo
USER_DB_PORT=27017
USER_DB_NAME=pos_identity
AUTH_DB_HOST=mongo
AUTH_DB_PORT=27017
AUTH_DB_NAME=pos_identity
MERCHANT_DB_HOST=mongo
MERCHANT_DB_PORT=27017
MERCHANT_DB_NAME=pos_merchant
CASHIER_DB_HOST=mongo
CASHIER_DB_PORT=27017
CASHIER_DB_NAME=pos_merchant
PRODUCT_DB_HOST=mongo
PRODUCT_DB_PORT=27017
PRODUCT_DB_NAME=pos_catalog
CATEGORY_DB_HOST=mongo
CATEGORY_DB_PORT=27017
CATEGORY_DB_NAME=pos_catalog
ORDER_DB_HOST=mongo
ORDER_DB_PORT=27017
ORDER_DB_NAME=pos_sales
ORDER_ITEM_DB_HOST=mongo
ORDER_ITEM_DB_PORT=27017
ORDER_ITEM_DB_NAME=pos_sales
TRANSACTION_DB_HOST=mongo
TRANSACTION_DB_PORT=27017
TRANSACTION_DB_NAME=pos_sales

SECRET_KEY=yantopedia

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dragon_knight

KAFKA_BROKERS=kafka:9092

# ClickHouse (stats pipeline F3)
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=pos
CLICKHOUSE_USERNAME=dragon
CLICKHOUSE_PASSWORD=dragon_knight
# JDBC URL for the Spring Boot stats services (HTTP interface on 8123).
CLICKHOUSE_URL=jdbc:clickhouse://clickhouse:8123/pos

# ---- Spring Boot gRPC client resolution (gateway + inter-service) ----
# gateway membaca grpc.client.<name>.host=${<NAME>_SERVICE_HOST:localhost}.
GATEWAY_PORT=5000
EMAIL_HTTP_PORT=8098
ROLE_SERVICE_HOST=role
USER_SERVICE_HOST=user
AUTH_SERVICE_HOST=auth
MERCHANT_SERVICE_HOST=merchant
CASHIER_SERVICE_HOST=cashier
CATEGORY_SERVICE_HOST=category
PRODUCT_SERVICE_HOST=product
ORDER_SERVICE_HOST=order
ORDER_ITEM_SERVICE_HOST=orderitem
TRANSACTION_SERVICE_HOST=transaction
STATS_READER_SERVICE_HOST=stats_reader

REDIS_DB_AUTH=0
REDIS_DB_ROLE=1
REDIS_DB_USER=2
REDIS_DB_CATEGORY=3
REDIS_DB_CASHIER=4
REDIS_DB_MERCHANT=5
REDIS_DB_ORDERITEM=6
REDIS_DB_ORDER=7
REDIS_DB_PRODUCT=8
REDIS_DB_TRANSACTION=9
REDIS_DB_GATEWAY=10
